// Cloudflare Worker 설정 (공개 사이트: https://campus-map.daseru.workers.dev)
// 저장소 루트의 정적 파일(앱 화면)과 버스 API 중계(relay/worker.js)를 한 주소에서 함께 제공한다.
// GitHub 저장소와 연결되어 있어 main 에 push 하면 Cloudflare 가 자동으로 다시 배포한다.
// 인증키는 여기 적지 말고 대시보드 Settings → Variables and Secrets 에 Secret(BUS_API_KEY)으로 등록한다.
{
  "name": "campus-map",
  "main": "relay/worker.js",
  "compatibility_date": "2025-09-24",
  // 파일이 있으면 그대로 보여 주고, 없는 경로(/api/bus/*)만 worker.js 가 처리한다
  // 공개하지 않을 파일은 .assetsignore 에 적는다
  "assets": { "directory": "." },
  "vars": {
    // 다른 주소의 앱(GitHub Pages 베타, 로컬)에서 버스 API 를 부를 수 있게 허용
    "ALLOWED_ORIGINS": "https://daseru0702.github.io,http://localhost:5173,http://127.0.0.1:5173"
  }
}
